generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  lastLogin DateTime?
  parties   Party[]
}

model Party {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug         String?  @unique
  honoreeName  String
  age          Int?
  theme        String   @default("infantil") // infantil | quinze | adulto
  color        String   @default("#ec4899")
  design       String   @default("padrao") // padrao | floresta | ...
  gallery      String   @default("grade") // grade | polaroid | mosaico | carrossel
  palette      String?  // JSON com as cores trocadas pelo organizador (só o que difere do padrão)
  date       DateTime
  endTime      String?
  venueName    String
  address      String
  message      String?
  coverUrl     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  guests       Guest[]
  photos       Photo[]
  gifts        Gift[]
}

model Guest {
  id          String    @id @default(cuid())
  partyId     String
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  token       String    @unique
  selfRegistered Boolean @default(false)
  status      String    @default("pending") // pending | yes | no
  companions  Int       @default(0)
  note        String?
  sentAt      DateTime?
  openedAt    DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  gifts       Gift[]
}

model Photo {
  id        String   @id @default(cuid())
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model Gift {
  id         String   @id @default(cuid())
  partyId    String
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name       String
  link       String?
  kind       String   @default("item") // item = escolhível | info = sugestão/informação
  guestId    String?
  guest      Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model AccessLog {
  id        String   @id @default(cuid())
  path      String
  kind      String   // page | invite | login | signup | rsvp
  userId    String?
  guestId   String?
  partyId   String?
  device    String?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  source    String   // server | client
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
